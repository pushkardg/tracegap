@@ -0,0 +1,73 @@
+# Copyright (c) Microsoft. All rights reserved.
+
+import asyncio
+import importlib
+
+import pytest
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import SimpleSpanProcessor
+from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
+from opentelemetry.trace import StatusCode
+
+from semantic_kernel.functions.kernel_function_decorator import kernel_function
+from semantic_kernel.functions.kernel_function_from_method import KernelFunctionFromMethod
+from semantic_kernel.kernel import Kernel
+
+# `semantic_kernel.functions.kernel_function` is shadowed by the decorator re-export.
+kernel_function_module = importlib.import_module("semantic_kernel.functions.kernel_function")
+
+
+@pytest.fixture
+def span_exporter(monkeypatch):
+    exporter = InMemorySpanExporter()
+    provider = TracerProvider()
+    provider.add_span_processor(SimpleSpanProcessor(exporter))
+    monkeypatch.setattr(kernel_function_module, "tracer", provider.get_tracer(__name__))
+    return exporter
+
+
+async def test_cancelled_function_invocation_marks_span_as_error(span_exporter):
+    started = asyncio.Event()
+
+    @kernel_function(name="blocking")
+    async def blocking() -> str:
+        started.set()
+        await asyncio.sleep(30)
+        return "unreachable"
+
+    function = KernelFunctionFromMethod(method=blocking, plugin_name="test")
+    task = asyncio.create_task(function.invoke(Kernel()))
+    await asyncio.wait_for(started.wait(), timeout=5)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+
+    spans = span_exporter.get_finished_spans()
+    assert len(spans) == 1
+    assert spans[0].status.status_code == StatusCode.ERROR
+
+
+async def test_cancelled_streaming_function_invocation_marks_span_as_error(span_exporter):
+    started = asyncio.Event()
+
+    @kernel_function(name="blocking_stream")
+    async def blocking_stream():
+        started.set()
+        await asyncio.sleep(30)
+        yield "unreachable"
+
+    function = KernelFunctionFromMethod(method=blocking_stream, plugin_name="test")
+
+    async def consume():
+        async for _ in function.invoke_stream(Kernel()):
+            pass
+
+    task = asyncio.create_task(consume())
+    await asyncio.wait_for(started.wait(), timeout=5)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+
+    spans = span_exporter.get_finished_spans()
+    assert len(spans) == 1
+    assert spans[0].status.status_code == StatusCode.ERROR

index 0000000..4fdf861
--- /dev/null
+++ b/python/packages/autogen-core/tests/test_telemetry_tool_span_cancellation.py
@@ -0,0 +1,34 @@
+import asyncio
+
+import pytest
+from opentelemetry.sdk.trace import TracerProvider
+from opentelemetry.sdk.trace.export import SimpleSpanProcessor
+from opentelemetry.sdk.trace.export.in_memory_span_exporter import InMemorySpanExporter
+from opentelemetry.trace import StatusCode
+
+from autogen_core import trace_tool_span
+
+
+@pytest.mark.asyncio
+async def test_trace_tool_span_marks_cancelled_tool_as_error() -> None:
+    exporter = InMemorySpanExporter()
+    provider = TracerProvider()
+    provider.add_span_processor(SimpleSpanProcessor(exporter))
+    started = asyncio.Event()
+
+    async def run_tool() -> None:
+        with trace_tool_span("slow_tool", tracer=provider.get_tracer(__name__), tool_call_id="1"):
+            started.set()
+            await asyncio.sleep(30)
+
+    task = asyncio.create_task(run_tool())
+    await asyncio.wait_for(started.wait(), timeout=5)
+    task.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await task
+
+    spans = exporter.get_finished_spans()
+    assert len(spans) == 1
+    assert spans[0].status.status_code == StatusCode.ERROR
+    assert spans[0].attributes is not None
+    assert spans[0].attributes["error.type"] == "CancelledError"

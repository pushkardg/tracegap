--- a/python/packages/autogen-agentchat/tests/test_assistant_agent.py
+++ b/python/packages/autogen-agentchat/tests/test_assistant_agent.py
@@ -3560,3 +3560,77 @@ async def test_anthropic_basic_text_response(self) -> None:
         usage = client.total_usage()
         assert usage.prompt_tokens > 0
         assert usage.completion_tokens > 0
+
+
+def _slow_tool_client() -> ReplayChatCompletionClient:
+    return ReplayChatCompletionClient(
+        [
+            CreateResult(
+                finish_reason="function_calls",
+                content=[FunctionCall(id="1", arguments=json.dumps({}), name="blocking_tool")],
+                usage=RequestUsage(prompt_tokens=10, completion_tokens=5),
+                cached=False,
+            ),
+            "done",
+        ],
+        model_info={
+            "function_calling": True,
+            "vision": False,
+            "json_output": False,
+            "family": ModelFamily.GPT_4O,
+            "structured_output": False,
+        },
+    )
+
+
+@pytest.mark.asyncio
+async def test_cancellation_token_cancelled_during_tool_execution_ends_run() -> None:
+    """Cancelling the token while a tool runs must end the run instead of hanging it."""
+    started = asyncio.Event()
+
+    async def blocking_tool() -> str:
+        started.set()
+        await asyncio.sleep(30)
+        return "unreachable"
+
+    agent = AssistantAgent(name="test_agent", model_client=_slow_tool_client(), tools=[blocking_tool])
+    cancellation_token = CancellationToken()
+    run = asyncio.create_task(agent.run(task="Test", cancellation_token=cancellation_token))
+    await asyncio.wait_for(started.wait(), timeout=5)
+    cancellation_token.cancel()
+
+    done, _ = await asyncio.wait([run], timeout=5)
+    if not done:
+        run.cancel()
+        pytest.fail("run() did not finish after the cancellation token was cancelled")
+    with pytest.raises(asyncio.CancelledError):
+        run.result()
+
+
+@pytest.mark.asyncio
+async def test_cancelling_run_task_cancels_in_flight_tool() -> None:
+    """Cancelling the task that runs the agent must also cancel the tool it is running."""
+    started = asyncio.Event()
+    tool_cancelled = asyncio.Event()
+    tool_finished = asyncio.Event()
+
+    async def blocking_tool() -> str:
+        started.set()
+        try:
+            await asyncio.sleep(0.5)
+        except asyncio.CancelledError:
+            tool_cancelled.set()
+            raise
+        tool_finished.set()
+        return "finished"
+
+    agent = AssistantAgent(name="test_agent", model_client=_slow_tool_client(), tools=[blocking_tool])
+    run = asyncio.create_task(agent.run(task="Test"))
+    await asyncio.wait_for(started.wait(), timeout=5)
+    run.cancel()
+    with pytest.raises(asyncio.CancelledError):
+        await run
+
+    await asyncio.sleep(0.8)
+    assert tool_cancelled.is_set()
+    assert not tool_finished.is_set()
